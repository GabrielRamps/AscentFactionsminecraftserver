# Copy to .env (git-ignored) and fill in real values.
# One .env per environment: dev / beta / prod use different DB names, ports, and passwords.

ASCENT_ENV=dev

# --- MariaDB (docker-compose.yml + plugin config) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ascent_dev
DB_USER=ascent
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
DB_BUFFER_POOL=1G

# --- Redis ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=change-me-three
REDIS_MAXMEMORY=512mb

# --- Paper server (server/*.sh, dev.sh) ---
# Where the test server lives. Defaults to ~/ascent-server if unset.
ASCENT_SERVER_DIR=
# Heap for start.sh. Dev box: 4G. Prod: 12G.
ASCENT_HEAP=4G
# Port the server listens on (dev 25566 / beta 25567 / prod 25565 per the PRD).
ASCENT_PORT=25566
