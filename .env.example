# Copy to .env and fill in. .env is git-ignored and must never be committed.
#   cp .env.example .env
#
# Generate passwords with:  openssl rand -base64 24

# --- MariaDB ---------------------------------------------------------------
MARIADB_ROOT_PASSWORD=change-me-root
MARIADB_DATABASE=ascent_dev
MARIADB_USER=ascent
MARIADB_PASSWORD=change-me-app
MARIADB_PORT=3306
MARIADB_BUFFER_POOL=1G

# --- Redis -----------------------------------------------------------------
REDIS_PASSWORD=change-me-redis
REDIS_PORT=6379
REDIS_MAXMEMORY=512mb

# --- Dev server ------------------------------------------------------------
# Where the Paper server lives. dev.sh and Gradle's copyToServer both read this.
ASCENT_SERVER_DIR=/home/YOUR_USER/ascent-server
# Heap for the dev server. Prod is 12G, beta is 4G (PRD §6.7).
ASCENT_MEMORY=4G
