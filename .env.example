# Copy to .env and fill in. .env is git-ignored and must never be committed.
#   cp .env.example .env
#
# Generate passwords with:  openssl rand -base64 24

# Both docker compose and the plugin read this file: compose to create the
# databases, scripts/start.sh to hand the plugin its credentials as environment
# variables. Keep the two in step by editing only here.

# --- MariaDB ---------------------------------------------------------------
MARIADB_ROOT_PASSWORD=change-me-root
MARIADB_DATABASE=ascent_dev
MARIADB_USER=ascent
MARIADB_PASSWORD=change-me-app
MARIADB_PORT=3306
MARIADB_BUFFER_POOL=1G
# Only if the database is not on this machine. Defaults to 127.0.0.1.
#MARIADB_HOST=127.0.0.1

# --- Redis -----------------------------------------------------------------
REDIS_PASSWORD=change-me-redis
REDIS_PORT=6379
REDIS_MAXMEMORY=512mb
#REDIS_HOST=127.0.0.1

# --- Dev server ------------------------------------------------------------
# Where the Paper server lives. dev.sh and Gradle's copyToServer both read this.
ASCENT_SERVER_DIR=/home/YOUR_USER/ascent-server
# Heap for the dev server. Prod is 12G, beta is 4G (PRD §6.7).
ASCENT_MEMORY=4G
